{
  "name": "debugclinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "^0.28.1",
    "minimatch": "^11.0.3"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c cyan,magenta \"npm run dev -w @debugclinic/frontend\" \"npm run dev -w @debugclinic/backend\"",
    "config:check": "tsx scripts/check-config.ts",
    "email:verify": "tsx scripts/verify-email.ts",
    "deployment:generate": "tsx scripts/prepare-deployment.ts",
    "build": "npm run deployment:generate && npm run db:generate && npm run build -w @debugclinic/contracts && npm run build -w @debugclinic/backend && npm run build -w @debugclinic/frontend",
    "build:netlify": "tsx scripts/netlify-build.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.functions.json --noEmit && tsc -p tsconfig.integration.json",
    "test": "vitest run",
    "test:api": "vitest run apps/backend/test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:verify": "node scripts/verify-database.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "netlify:dev": "npx --yes netlify-cli@27.16.1 dev",
    "prepare": "npm run deployment:generate && npm run db:generate && npm run build -w @debugclinic/contracts"
  },
  "dependencies": {
    "serverless-http": "^4.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prisma": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}

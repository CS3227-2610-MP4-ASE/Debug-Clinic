NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://debugclinic:debugclinic@localhost:5432/debugclinic?schema=public
DATABASE_URL_POOLED=postgresql://debugclinic:debugclinic@localhost:5432/debugclinic?schema=public
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only on stable dev and trusted PR previews; leave unset on actual production.
OAUTH_PROXY_URL=
OAUTH_PROXY_SECRET=
# Dedicated Gmail sender; SMTP_PASSWORD is an app password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
AI_PROVIDER=fake
SOC_LLM_ENDPOINT=https://soclaas-api.comp.nus.edu.sg/v1/chat/completions
SOC_LLM_MODEL=
SOC_LLM_API_KEY=
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=2
LOG_LEVEL=info
